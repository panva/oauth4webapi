{
  "include": ["**/*.ts"],
  "exclude": ["fallback.ts", "fallback.const.ts", "fallback.let.ts", "lexical-host.d.ts", "node.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
