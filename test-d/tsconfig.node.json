{
  "files": ["node.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
